{
  "name": "codex-navo",
  "productName": "Codex Navo",
  "private": true,
  "version": "1.2.4",
  "description": "A local Windows account environment switcher for Codex.",
  "main": "desktop-src/main.js",
  "author": "1080ssf",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "electron .",
    "test": "node --test test/*.test.js",
    "test:mail-otp-mock": "node scripts/mail-otp-mock-server.js --fixture test/fixtures/mail-otp.json --port 48080",
    "test:mail-otp": "node scripts/mail-otp-check.js --fixture test/fixtures/mail-otp.json",
    "test:mail-otp:interactive": "node scripts/mail-otp-check.js",
    "collect:mail-metadata": "node scripts/mail-metadata-collector.js",
    "test:smoke": "node test/smoke.js",
    "build:desktop": "electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "com.codexswitchboard.app",
    "productName": "Codex Navo",
    "asar": true,
    "directories": {
      "output": "release/auto-update"
    },
    "files": [
      "desktop-src/**/*",
      "server.js",
      "lib/**/*",
      "vendor/tosub2/**/*",
      "public/**/*",
      "config/settings.example.json",
      "README.md",
      "THIRD_PARTY_NOTICES.md",
      "LICENSE",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop-src/icon.ico",
      "artifactName": "Codex-Navo-Setup-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "1080ssf",
      "repo": "codex-navo"
    }
  }
}
